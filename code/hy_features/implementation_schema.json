{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/T-Thomp/LakeDelineationTool/hy_features/implementation_schema.json",
  "title": "Lake Delineation Tool HY_Features Implementation Schema",
  "description": "Machine-readable implementation schema for profile LakeDelineationTool-DendriticGeofabric-1.0. Read by hy_features/validate.py. Human-readable mapping: docs/hy_features_mapping.md",
  "profile": "LakeDelineationTool-DendriticGeofabric-1.0",
  "standard": "OGC 14-111r6 — WaterML 2 Part 3 HY_Features",
  "standard_uri": "https://docs.ogc.org/is/14-111r6/14-111r6.html",
  "uml_uri": "https://docs.ogc.org/is/14-111r6/uml/",
  "definitions_server": "https://www.opengis.net/def/appschema/hy_features/hyf/",
  "conformance_class": "/conf/hy_features_conceptual_model",
  "conformance_tests": [
    "/conf/hy_features_conceptual_model/mapping",
    "/req/hy_features_conceptual_model/GF_Feature"
  ],
  "requirements_class": "/req/hy_features_conceptual_model",
  "encoding": {
    "primary": "OGC GeoPackage 1.0+",
    "metadata": "JSON (UTF-8)",
    "default_network_id": "study_hydrographic_network",
    "default_domain_catchment_id": "domain",
    "outlet_sentinel": -9999
  },
  "products": {
    "geofabric.gpkg": {
      "description": "Multi-layer GeoPackage; canonical product (spatial layers + attribute tables)",
      "required_layers": ["catchment_area", "catchment_divide", "flowpath", "hydro_nexus", "hydro_location", "channel_network"],
      "required_tables": ["catchment", "catchment_realization", "nexus_contributing_catchment", "catchment_divide_adjacency"],
      "optional_layers": ["waterbody", "hydrometric_feature", "gauge_catchment", "hydrometric_network"],
      "optional_tables": ["catchment_association", "catchment_containment", "catchment_upper_catchment", "waterbody_upstream_waterbody", "hydrometric_network_station", "feature_name"]
    },
    "geofabric_aggregated.gpkg": {
      "description": "Same schema for the basinAggregation fabric; catchment ids prefixed agg_, catchment_containment links each aggregate to the geofabric.gpkg catchments it contains"
    },
    "hydrographic_network.json": {
      "hy_feature_type": "HY_HydrographicNetwork",
      "root_keys": ["hydrographic_network", "dendritic_catchment"]
    },
    "catchment_registry.json": {
      "root_keys": ["catchments", "realizations", "associations", "containments"]
    }
  },
  "geopackage_layers": {
    "catchment_area": {
      "gf_feature": true,
      "hy_feature_types": ["HY_CatchmentArea"],
      "geometry_type": "Polygon",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "hy_property": "GF_Feature identifier", "notes": "Pattern ca_{catchment_id}" },
        { "name": "network_id", "type": "string", "required": true, "hy_property": "hydrographicNetwork" },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_CatchmentArea"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "catchment_id", "type": "string", "required": true, "hy_property": "code" },
        { "name": "realizes_catchment", "type": "string", "required": true, "hy_property": "realizedCatchment" },
        { "name": "outflow_nexus_id", "type": "string", "required": true, "hy_property": "realizedCatchment.outflow" },
        { "name": "inflow_nexus_id", "type": "string", "required": false, "nillable": true, "hy_property": "realizedCatchment.inflow" },
        { "name": "upper_catchment_id", "type": "string", "required": false, "nillable": true, "notes": "Convenience copy of catchment_upper_catchment" },
        { "name": "is_lake_catchment", "type": "integer", "required": false, "notes": "TauDEM routing flag only" },
        { "name": "lake_type", "type": "integer", "required": false, "notes": "HydroLAKES Lake_type when merged" },
        { "name": "waterbody_id", "type": "string", "required": false, "nillable": true, "notes": "Profile extension: water body merged into this lake catchment" },
        { "name": "waterbody_class", "type": "string", "required": false, "nillable": true, "allowed_values": ["HY_Lake", "HY_Impoundment"] },
        { "name": "lake_area_m2", "type": "number", "required": false },
        { "name": "frac_lake", "type": "number", "required": false },
        { "name": "station_code", "type": "string", "required": false, "nillable": true },
        { "name": "geometry", "type": "geometry", "geometry_type": "Polygon", "required": true, "hy_property": "shape" }
      ]
    },
    "catchment_divide": {
      "gf_feature": true,
      "hy_feature_types": ["HY_CatchmentDivide"],
      "geometry_type": "LineString",
      "description": "Catchment boundary as a line (polygon ring); neighbours in catchment_divide_adjacency",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern dv_{catchment_id}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_CatchmentDivide"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "catchment_id", "type": "string", "required": true, "hy_property": "code" },
        { "name": "realizes_catchment", "type": "string", "required": true, "hy_property": "realizedCatchment" },
        { "name": "adjacent_catchment_id", "type": "string", "required": false, "nillable": true, "notes": "Convenience copy of catchment_divide_adjacency" },
        { "name": "perimeter_m", "type": "number", "required": false },
        { "name": "geometry", "type": "geometry", "geometry_type": "LineString", "required": true, "hy_property": "shape" }
      ]
    },
    "gauge_catchment": {
      "gf_feature": true,
      "hy_feature_types": ["HY_CatchmentArea"],
      "geometry_type": "Polygon",
      "description": "Area draining to a hydrometric station (union of the upstream catchment areas, host catchment included)",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern gca_{station_code}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_CatchmentArea"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "catchment_id", "type": "string", "required": true, "notes": "gauge_{station_code}" },
        { "name": "realizes_catchment", "type": "string", "required": true, "hy_property": "realizedCatchment" },
        { "name": "outflow_nexus_id", "type": "string", "required": true, "hy_property": "realizedCatchment.outflow", "notes": "nx_gauge_{station_code}" },
        { "name": "station_code", "type": "string", "required": true },
        { "name": "hydrometric_feature_id", "type": "string", "required": true },
        { "name": "host_catchment_id", "type": "string", "required": true },
        { "name": "member_count", "type": "integer", "required": false },
        { "name": "area_km2", "type": "number", "required": false },
        { "name": "geometry", "type": "geometry", "geometry_type": "Polygon", "required": true, "hy_property": "shape" }
      ]
    },
    "flowpath": {
      "gf_feature": true,
      "hy_feature_types": ["HY_Flowpath"],
      "geometry_type": "LineString",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern fp_{flowpath_id}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_Flowpath"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "flowpath_id", "type": "string", "required": true },
        { "name": "catchment_id", "type": "string", "required": true, "notes": "Equals flowpath_id in the dendritic TauDEM network" },
        { "name": "realizes_catchment", "type": "string", "required": true, "hy_property": "realizedCatchment" },
        { "name": "lower_catchment_id", "type": "string", "required": true, "nillable": true, "hy_property": "realizedCatchment.lowerCatchment" },
        { "name": "outflow_nexus_id", "type": "string", "required": true, "hy_property": "realizedCatchment.outflow" },
        { "name": "inflow_nexus_id", "type": "string", "required": false, "nillable": true, "hy_property": "realizedCatchment.inflow" },
        { "name": "upper_catchment_id", "type": "string", "required": false, "nillable": true },
        { "name": "geometry", "type": "geometry", "geometry_type": "LineString", "required": true, "hy_property": "shape" }
      ]
    },
    "hydro_location": {
      "gf_feature": true,
      "hy_feature_types": ["HY_HydroLocation"],
      "geometry_type": "Point",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern hl_{n}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_HydroLocation"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "hydro_loc_type", "type": "string", "required": true, "hy_property": "hydroLocationType", "allowed_values": ["confluence", "river mouth", "catchment outlet", "hydrometric station", "pour point"] },
        { "name": "realized_nexus_id", "type": "string", "required": true, "nillable": true, "hy_property": "realizedNexus", "notes": "Empty only for pour points not near a network nexus" },
        { "name": "contributing_catchment_id", "type": "string", "required": false, "nillable": true, "notes": "Catchments whose outlets coincide at this point" },
        { "name": "waterbody_id", "type": "string", "required": false, "nillable": true },
        { "name": "feature_name", "type": "string", "required": false, "nillable": true, "hy_property": "name" },
        { "name": "geometry", "type": "geometry", "geometry_type": "Point", "required": true, "hy_property": "shape" }
      ]
    },
    "channel_network": {
      "gf_feature": true,
      "hy_feature_types": ["HY_ChannelNetwork"],
      "geometry_type": "MultiLineString",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Equals channel_network_id" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "channel_network_id", "type": "string", "required": true },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_ChannelNetwork"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "realizes_catchment", "type": "string", "required": true, "hy_property": "realizedCatchment", "notes": "Study-domain HY_CatchmentAggregate" },
        { "name": "drainage_pattern", "type": "string", "required": true, "hy_property": "drainagePattern", "allowed_values": ["dendritic"] },
        { "name": "flowpath_count", "type": "integer", "required": false },
        { "name": "geometry", "type": "geometry", "geometry_type": "MultiLineString", "required": true, "hy_property": "shape" }
      ]
    },
    "waterbody": {
      "gf_feature": true,
      "hy_feature_types": ["HY_Lake", "HY_Impoundment"],
      "geometry_type": "Polygon",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern wb_{waterbody_id}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "waterbody_id", "type": "string", "required": true },
        { "name": "feature_name", "type": "string", "required": false, "nillable": true, "hy_property": "name", "source": "HydroLAKES Lake_name" },
        { "name": "waterbody_class", "type": "string", "required": true, "allowed_values": ["HY_Lake", "HY_Impoundment"] },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_Lake", "HY_Impoundment"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "upstream_waterbody_id", "type": "string", "required": false, "nillable": true, "hy_property": "upstreamWaterBody", "notes": "Convenience copy of waterbody_upstream_waterbody" },
        { "name": "downstream_waterbody_id", "type": "string", "required": false, "nillable": true, "hy_property": "downstreamWaterBody" },
        { "name": "geometry", "type": "geometry", "geometry_type": "Polygon", "required": true, "hy_property": "shape" }
      ]
    },
    "hydrometric_feature": {
      "gf_feature": true,
      "hy_feature_types": ["HY_HydrometricFeature"],
      "geometry_type": "Point",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern hm_{station_code}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "station_code", "type": "string", "required": true },
        { "name": "feature_name", "type": "string", "required": false, "nillable": true, "hy_property": "name", "source": "HYDAT STATION_NAME" },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_HydrometricFeature"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "hydro_loc_type", "type": "string", "required": true, "allowed_values": ["hydrometric station"] },
        { "name": "catchment_id", "type": "string", "required": true },
        { "name": "host_flowpath_id", "type": "string", "required": true, "hy_property": "positionOnRiver.linearElement" },
        { "name": "linear_element_id", "type": "string", "required": true, "hy_property": "positionOnRiver.linearElement" },
        { "name": "reference_nexus_id", "type": "string", "required": true, "hy_property": "positionOnRiver.referenceLocation" },
        { "name": "distance_from_outlet_m", "type": "number", "required": true, "hy_property": "positionOnRiver.distanceExpression" },
        { "name": "distance_from_outlet_pct", "type": "number", "required": true, "hy_property": "positionOnRiver.distanceExpression" },
        { "name": "distance_description", "type": "string", "required": true, "allowed_values": ["upstream"], "hy_property": "positionOnRiver.distanceDescription" },
        { "name": "realized_nexus_id", "type": "string", "required": false, "nillable": true, "hy_property": "realizedNexus", "notes": "nx_gauge_{station_code}, the outflow of the gauge catchment (outlet-at-station)" },
        { "name": "geometry", "type": "geometry", "geometry_type": "Point", "required": true, "hy_property": "shape" }
      ]
    }
  },
  "geopackage_tables": {
    "hydro_nexus": {
      "gf_feature": true,
      "hy_feature_types": ["HY_HydroNexus"],
      "description": "Topological nexuses (no geometry); located through hydro_location.realized_nexus_id",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Equals nexus_id" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "nexus_id", "type": "string", "required": true, "notes": "nx_{receiving_catchment_id}, or nx_out_{catchment_id} at a domain outlet" },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_HydroNexus"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "contributing_catchment_id", "type": "string", "required": true, "hy_property": "contributingCatchment", "notes": "Convenience copy of nexus_contributing_catchment" },
        { "name": "receiving_catchment_id", "type": "string", "required": true, "nillable": true, "hy_property": "receivingCatchment" }
      ]
    },
    "catchment": {
      "gf_feature": true,
      "hy_feature_types": ["HY_DendriticCatchment", "HY_CatchmentAggregate"],
      "description": "Holistic catchments; realizations in catchment_realization",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern cat_{catchment_id}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "catchment_id", "type": "string", "required": true, "hy_property": "code" },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_DendriticCatchment", "HY_CatchmentAggregate"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "outflow_nexus_id", "type": "string", "required": true, "nillable": true, "hy_property": "outflow", "notes": "Exactly one per HY_DendriticCatchment" },
        { "name": "inflow_nexus_id", "type": "string", "required": false, "nillable": true, "hy_property": "inflow" },
        { "name": "lower_catchment_id", "type": "string", "required": false, "nillable": true, "hy_property": "lowerCatchment" },
        { "name": "upper_catchment_id", "type": "string", "required": false, "nillable": true, "hy_property": "upperCatchment" },
        { "name": "waterbody_id", "type": "string", "required": false, "nillable": true }
      ]
    },
    "catchment_realization": {
      "description": "catchmentRealization: one row per realization feature",
      "columns": [
        { "name": "catchment_id", "type": "string", "required": true },
        { "name": "realization_type", "type": "string", "required": true, "allowed_values": ["HY_CatchmentArea", "HY_CatchmentDivide", "HY_Flowpath", "HY_HydrographicNetwork", "HY_ChannelNetwork", "HY_HydrometricNetwork"] },
        { "name": "feature_id", "type": "string", "required": true }
      ]
    },
    "catchment_association": {
      "description": "Non-realization links from a catchment",
      "columns": [
        { "name": "catchment_id", "type": "string", "required": true },
        { "name": "feature_type", "type": "string", "required": true },
        { "name": "feature_id", "type": "string", "required": true },
        { "name": "role", "type": "string", "required": true, "allowed_values": ["outflow", "networkWaterBody", "positionOnRiver"] }
      ]
    },
    "catchment_containment": {
      "description": "containingCatchment / containedCatchment",
      "columns": [
        { "name": "containing_catchment_id", "type": "string", "required": true, "hy_property": "containedCatchment (from containing side)" },
        { "name": "contained_catchment_id", "type": "string", "required": true, "hy_property": "containingCatchment (from contained side)" }
      ]
    },
    "catchment_upper_catchment": {
      "description": "upperCatchment 0..*",
      "columns": [
        { "name": "catchment_id", "type": "string", "required": true },
        { "name": "upper_catchment_id", "type": "string", "required": true, "hy_property": "upperCatchment" }
      ]
    },
    "nexus_contributing_catchment": {
      "description": "HY_HydroNexus.contributingCatchment 0..*",
      "columns": [
        { "name": "nexus_id", "type": "string", "required": true },
        { "name": "contributing_catchment_id", "type": "string", "required": true, "hy_property": "contributingCatchment" },
        { "name": "receiving_catchment_id", "type": "string", "required": true, "nillable": true, "hy_property": "receivingCatchment" }
      ]
    },
    "waterbody_upstream_waterbody": {
      "description": "upstreamWaterBody 0..*",
      "columns": [
        { "name": "waterbody_id", "type": "string", "required": true },
        { "name": "upstream_waterbody_id", "type": "string", "required": true, "hy_property": "upstreamWaterBody" }
      ]
    },
    "catchment_divide_adjacency": {
      "description": "Catchment across each part of a HY_CatchmentDivide; empty adjacent_catchment_id = study-domain boundary",
      "columns": [
        { "name": "catchment_id", "type": "string", "required": true },
        { "name": "adjacent_catchment_id", "type": "string", "required": true, "nillable": true },
        { "name": "shared_length_m", "type": "number", "required": true }
      ]
    },
    "hydrometric_network": {
      "gf_feature": true,
      "hy_feature_types": ["HY_HydrometricNetwork"],
      "description": "One network per gauge catchment; the outlet station is its outflow (outlet-at-station)",
      "columns": [
        { "name": "feature_id", "type": "string", "required": true, "notes": "Pattern hmn_{station_code}" },
        { "name": "network_id", "type": "string", "required": true },
        { "name": "hydrometric_network_id", "type": "string", "required": true },
        { "name": "hyf_type", "type": "string", "required": true, "allowed_values": ["HY_HydrometricNetwork"] },
        { "name": "hyf_type_uri", "type": "string", "required": true, "format": "uri" },
        { "name": "realizes_catchment", "type": "string", "required": true, "hy_property": "realizedCatchment" },
        { "name": "outlet_station_id", "type": "string", "required": true },
        { "name": "feature_name", "type": "string", "required": false, "nillable": true, "hy_property": "name" }
      ]
    },
    "hydrometric_network_station": {
      "description": "HY_HydrometricNetwork.networkStation 0..* / HY_HydrometricFeature.hydrometricNetwork 0..*",
      "columns": [
        { "name": "hydrometric_network_id", "type": "string", "required": true, "hy_property": "hydrometricNetwork" },
        { "name": "hydrometric_feature_id", "type": "string", "required": true, "hy_property": "networkStation" }
      ]
    },
    "feature_name": {
      "description": "HY_HydroFeatureName: one row per name of a feature",
      "columns": [
        { "name": "named_feature_id", "type": "string", "required": true, "notes": "feature_id of the named feature" },
        { "name": "hyf_type", "type": "string", "required": true },
        { "name": "name", "type": "string", "required": true, "hy_property": "name" },
        { "name": "language", "type": "string", "required": true, "notes": "Profile extension: ISO 639 code, und when unknown" },
        { "name": "usage", "type": "string", "required": true, "hy_property": "usage", "allowed_values": ["conventional", "historical", "official", "vernacular"] },
        { "name": "preferred_by", "type": "string", "required": true, "nillable": true, "hy_property": "preferredBy" },
        { "name": "names_part", "type": "string", "required": true, "hy_property": "namesPart", "allowed_values": ["true", "false"] },
        { "name": "variant_spelling", "type": "string", "required": true, "hy_property": "variantSpelling", "allowed_values": ["true", "false"] }
      ]
    }
  },
  "json_sidecars": {
    "dendritic_catchment": {
      "hy_feature_type": "HY_DendriticCatchment",
      "location": "hydrographic_network.json → dendritic_catchment[]",
      "fields": {
        "catchment_id": { "type": "string", "hy_property": "code" },
        "hyf_type": { "const": "HY_DendriticCatchment" },
        "hyf_type_uri": { "type": "string", "format": "uri" },
        "outflow_nexus_id": { "type": "string", "hy_property": "outflow" },
        "inflow_nexus_id": { "type": "string", "nillable": true, "hy_property": "inflow" },
        "lower_catchment_id": { "type": "string", "nillable": true, "hy_property": "lowerCatchment" },
        "upper_catchment_id": { "type": "string", "nillable": true, "hy_property": "upperCatchment" },
        "waterbody_id": { "type": "string", "nillable": true }
      }
    },
    "hydrographic_network": {
      "hy_feature_type": "HY_HydrographicNetwork",
      "location": "hydrographic_network.json → hydrographic_network",
      "fields": {
        "network_id": { "type": "string" },
        "hyf_type": { "const": "HY_HydrographicNetwork" },
        "hyf_type_uri": { "type": "string", "format": "uri" },
        "realized_catchment": { "type": "string", "hy_property": "realizedCatchment", "notes": "Study-domain HY_CatchmentAggregate id" },
        "outlet_catchments": { "type": "array", "items": "string" },
        "channel_network_id": { "type": "string" },
        "flowpath_members": { "type": "array", "items": "string" },
        "waterbody_members": { "type": "array", "items": "string", "hy_property": "networkWaterBody" },
        "flowpath_count": { "type": "integer" },
        "waterbody_count": { "type": "integer" },
        "nexus_contributing_catchment": { "type": "array", "items": ["nexus_id", "contributing_catchment_id", "receiving_catchment_id"] }
      }
    },
    "catchment_registry": {
      "location": "catchment_registry.json",
      "catchments": {
        "description": "Map catchment_id → holistic catchment record",
        "fields": ["code", "hyf_type", "outflow_nexus_id", "inflow_nexus_id", "lower_catchment_id", "upper_catchment_ids", "waterbody_id"]
      },
      "realizations": {
        "description": "catchmentRealization links",
        "fields": ["catchment_id", "realization_type", "feature_id", "notes"]
      },
      "associations": {
        "description": "Non-realization links: outflow HY_HydroNexus, networkWaterBody, positionOnRiver",
        "fields": ["catchment_id", "feature_type", "feature_id", "role"]
      },
      "containments": {
        "description": "containingCatchment / containedCatchment",
        "fields": ["containing_catchment_id", "contained_catchment_id"]
      }
    }
  },
  "enumerations": {
    "hydrolakes_lake_type_to_hyf_type": {
      "1": "HY_Lake",
      "2": "HY_Impoundment",
      "3": "HY_Impoundment"
    },
    "hydro_location_type_annex_b1": [
      "confluence",
      "river mouth",
      "catchment outlet",
      "hydrometric station",
      "pour point"
    ],
    "pour_point_type_mapping": {
      "inflow": "river mouth",
      "outflow": "catchment outlet",
      "gauge": "hydrometric station"
    },
    "distance_description_annex_b2": ["upstream"],
    "drainage_pattern_annex_b3": "dendritic",
    "name_usage_annex_b4": ["conventional", "historical", "official", "vernacular"]
  },
  "identity_rules": {
    "nexus_id_template": "nx_{receiving_catchment_id}",
    "terminal_nexus_id_template": "nx_out_{catchment_id}",
    "gauge_nexus_id_template": "nx_gauge_{station_code}",
    "gauge_catchment_id_template": "gauge_{station_code}",
    "aggregated_catchment_id_template": "agg_{LINKNO}",
    "id_format": "integer strings (no trailing .0)",
    "feature_id_prefixes": {
      "catchment": "cat_",
      "catchment_area": "ca_",
      "catchment_divide": "dv_",
      "gauge_catchment": "gca_",
      "hydrometric_network": "hmn_",
      "flowpath": "fp_",
      "hydro_nexus": "",
      "hydro_location": "hl_",
      "channel_network": "",
      "waterbody": "wb_",
      "hydrometric_feature": "hm_"
    },
    "hyf_type_uri_template": "https://www.opengis.net/def/appschema/hy_features/hyf/{hyf_type}"
  }
}
